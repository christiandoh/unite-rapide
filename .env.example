# ──────────────────────────────────────────────
# USSD AUTOMATION PLATFORM — ENVIRONMENT VARIABLES
# ──────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=ussd_automation
POSTGRES_USER=ussd_admin
POSTGRES_PASSWORD=change_me_postgres_password

# Redis
REDIS_PASSWORD=change_me_redis_password

# JWT
JWT_SECRET=change_me_jwt_secret_min_32_chars_long_xxx
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long_xxx

# Jeko (paiement Mobile Money) — Cockpit: https://cockpit.jeko.africa/
# Paramètres > API & Webhooks : JEKO_API_KEY + JEKO_API_KEY_ID + webhook secret
JEKO_API_KEY=your_jeko_api_key
JEKO_API_KEY_ID=your_jeko_api_key_id
JEKO_STORE_ID=your_jeko_store_uuid
JEKO_WEBHOOK_SECRET=change_me_jeko_webhook_secret
JEKO_DEFAULT_PAYMENT_METHOD=wave
JEKO_API_BASE=https://api.jeko.africa
FRONTEND_URL=http://localhost:8082

# IA Validator
IA_CONFIDENCE_THRESHOLD=0.85

# CORS
CORS_ORIGIN=http://localhost:8082

# Admin (code PIN à 4 chiffres — OBLIGATOIRE pour le seed)
ADMIN_PHONE=0700000000
ADMIN_PIN=4829

# USSD scalability
USSD_MAX_CONCURRENT_PER_PHONE=4
USSD_QUEUE_CONCURRENCY=8
USSD_PHONE_ONLINE_THRESHOLD_MS=120000

# Logging
LOG_LEVEL=info
